# Public portfolio origin. This is also the application's default.
SITE_URL=https://syntaxsurge.com
# No database or secrets are required for this portfolio.

# Optional production startup settings for pnpm deploy:server (pnpm serve alias).
# The shortcut force-syncs the server checkout to origin/main on every start.
# Keep production environment files untracked; source edits are discarded.
# PORT=3101
# Runtime must be outside the source checkout and must not contain it,
# including through symlinks; use sibling source and runtime directories.
# PORTFOLIO_DEPLOY_DIR=/www/syntaxsurge-portfolio/runtime
